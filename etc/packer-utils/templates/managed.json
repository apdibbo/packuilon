{
  "builders": [
    {
      "type": "openstack",
      "ssh_username": "packer",
      "user_data_file": "/etc/packer-utils/cloud-init.txt"
    }
  ],
  "provisioners": [
    {
      "type": "shell",
      "inline": [
          "sudo yum install ansible -y",
          "ls /usr/lib/stfc-cloud || sudo mkdir /usr/lib/stfc-cloud",
          "cd /usr/lib/stfc-cloud",
          "sudo rm -rf cloud-image-builders",
          "sudo git clone https://github.com/stfc/cloud-image-builders",
          "cd cloud-image-builders",
          "sudo ansible-playbook os_builders/prepare_user_image.yml --extra-vars provision_this_machine=true -i os_builders/inventory/localhost.yml"
      ]
  },
  {
      "type": "shell",
      "expect_disconnect": true,
      "pause_after": "180s",
      "inline": [
          "sudo reboot"
      ]
  },
  {
    "type": "shell",
    "max_retries": 10,
    "inline": [
        "cd /usr/lib/stfc-cloud/cloud-image-builders",
        "sudo ansible-playbook os_builders/prepare_user_image_post_reboot.yml --extra-vars provision_this_machine=true -i os_builders/inventory/localhost.yml"
    ]
}
  ],
  "post-processors": [
    {
      "type": "shell-local",
      "inline": [
        "source /etc/packer-utils/admin-auth.sh; python /usr/local/bin/rename-old-images.py $NAME"
      ]
    }
  ]
}
