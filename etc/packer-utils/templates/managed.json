{
  "builders": [
    {
      "type": "openstack",
      "ssh_username": "packer",
      "user_data_file": "/etc/packer-utils/cloud-init.txt"
    }
  ],
  "provisioners": [
    {
      "type": "shell-local",
      "inline": [
          "cd /tmp",
          "rm -rf cloud-image-builders",
          "git clone https://github.com/apdibbo/cloud-image-builders",
          "cd cloud-image-builders",
          "git checkout origin/migrate-more-prepvm",
          "cd os_builders"
      ]
  },
  {
      "type": "ansible",
      "user": "packer",
      "keep_inventory_file": true,
      "extra_arguments": [
          "--extra-vars",
          "provision_this_machine=true"
      ],
      "playbook_file": "/tmp/cloud-image-builders/os_builders/prepare_user_image.yml"
  },
  {
      "type": "shell",
      "expect_disconnect": true,
      "pause_after": "180s",
      "inline": [
          "sudo reboot"
      ]
  },
  {
      "type": "ansible",
      "user": "packer",
      "max_retries": 10,
      "keep_inventory_file": true,
      "extra_arguments": [
          "--extra-vars",
          "provision_this_machine=true"
      ],
      "playbook_file": "/tmp/cloud-image-builders/os_builders/prepare_user_image_post_reboot.yml"
  }
  ],
  "post-processors": [
    {
      "type": "shell-local",
      "inline": [
        "source /etc/packer-utils/admin-auth.sh; rename-old-images.sh $NAME AQ"
      ]
    }
  ]
}
